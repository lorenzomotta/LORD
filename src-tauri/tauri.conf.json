{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lord",
  "version": "0.2.0",
  "identifier": "com.relaziolore.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Lord",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "lorenzomotta",
    "homepage": "https://github.com/lorenzomotta/Lord",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA4RjFEN0Q4OTVGRjg2MTIKUldRU2h2K1YyTmZ4Q0grd2xHWEpZK3J4NGI3QlhoSlp3UmFVTUlBdmYvYzEyNFU3czRuejdsTnAK",
      "endpoints": [
        "https://github.com/lorenzomotta/Lord/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}